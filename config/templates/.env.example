# Exemplo de variaveis necessarias para operar o pipeline.
# NUNCA commitar um arquivo .env real. Em produção, configure estes valores
# como GitLab CI/CD Variables (Settings > CI/CD > Variables), marcando
# senhas/tokens como "Masked" e variaveis de producao como "Protected".

# --- GitLab ---
GITLAB_URL=http://<OOB_SERVER_IP>
GITLAB_TOKEN=<gitlab-api-token>
CI_PROJECT_ID=<project-id>
DRIFT_BOT_TOKEN=<token-dedicado-para-bot-de-drift>
OXIDIZED_TRIGGER_TOKEN=<token-de-pipeline-trigger>

# --- NetBox ---
NETBOX_URL=http://<OOB_SERVER_IP>:8080
NETBOX_TOKEN=<netbox-api-token>

# --- NETCONF / dispositivos ---
NETCONF_USERNAME=<usuario-de-servico-dedicado>
NETCONF_PASSWORD=<senha-ou-usar-chave-ssh>

# --- NAPALM / fallback CLI ---
NAPALM_USERNAME=<usuario-de-servico-dedicado>
NAPALM_PASSWORD=<senha>

# --- Terraform / MinIO remote state ---
TF_VAR_netbox_token=<netbox-api-token>
MINIO_ACCESS_KEY=<access-key>
MINIO_SECRET_KEY=<secret-key>
MINIO_ENDPOINT=http://<OOB_SERVER_IP>:9000

# --- Backup ---
BACKUP_REPO=/srv/config-backups
REPO_PATH=.

# --- Ansible Vault ---
ANSIBLE_VAULT_PASS=<senha-do-vault>
